legacy-peer-deps=true

# Hoist all packages so Next.js/Turbopack can resolve transitive deps
# from @payloadcms/ui and @payloadcms/drizzle in production builds.
shamefully-hoist=true

# Don't resolve packages published in the last 7 days — gives time for
# malicious or broken releases to be caught and pulled.
min-release-age=7